# Cloudflare D1 REST API credentials — required for the collector to write data.
# Get these from the Cloudflare dashboard (Workers & Pages > your account > API Tokens)
# and from `wrangler d1 info yieldlens`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Must match worker/wrangler.toml's [vars] TABLE_PREFIX. Leave empty to match the default.
# Normalisation is shared with the Worker: "yl" and "yl_" both mean yl_.
TABLE_PREFIX=

# ── collect_prices.py ────────────────────────────────────────────────────────
# auto (default) = bulk snapshot, switching to "close" after 15:05 Beijing time.
# snapshot = bulk full-market snapshot now (intraday or close).
# close    = bulk snapshot after the close; always re-fetches and overwrites today.
# history  = per-stock daily bars, sharded with a daily cursor (snapshot fallback).
# backfill = per-stock ~10-year history, sharded with a persistent cursor.
PRICE_MODE=auto

# Stocks per shard for history/backfill modes. Each shard is designed to finish
# well inside the 25-minute job timeout; the cursor resumes on the next run.
PRICE_BATCH_SIZE=600

# Legacy compatibility: BACKFILL_MODE=true is treated as PRICE_MODE=backfill.
# BACKFILL_MODE=false

# ── collect_dividends.py ────────────────────────────────────────────────────
# daily (default) = the three most recently disclosed report periods.
# backfill        = the last 10 years, or BACKFILL_PERIODS periods.
COLLECT_MODE=daily

# Only used when COLLECT_MODE=backfill. 20 periods = ~10 years.
BACKFILL_PERIODS=20
