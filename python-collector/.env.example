# Cloudflare D1 REST API credentials — required for the collector to write data.
# Get these from the Cloudflare dashboard (Workers & Pages > your account > API Tokens)
# and from `wrangler d1 info yieldlens`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Must match worker/wrangler.toml's [vars] TABLE_PREFIX. Leave empty to match the default.
TABLE_PREFIX=

# collect_prices.py only: set to "true" to backfill historical OHLCV instead of
# incremental daily updates, and pick a 0-49 batch index to process a slice of
# the stock list (avoids single-run timeouts / API rate limiting on full backfill).
BACKFILL_MODE=false
BACKFILL_BATCH=0

# collect_dividends.py only: number of historical report periods to backfill
# (each period is one ak.stock_fhps_em() call covering the whole market).
# Use a large number (e.g. 20) for the initial backfill, 1 for daily incremental runs.
BACKFILL_PERIODS=1
